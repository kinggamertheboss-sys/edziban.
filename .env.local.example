# Edziban Environment Variables
# Copy this file to .env.local and fill in your real keys.
# Never commit .env.local to git.

# ── SMS (Twilio) ──────────────────────────────────────────────────────────────
# Phone number must be SMS-capable and toll-free verified before it can send.
# TWILIO_ACCOUNT_SID: console.twilio.com → Account Info
# TWILIO_API_KEY_SID / TWILIO_API_KEY_SECRET: Account → Keys & Credentials → API keys & tokens
#   → Create new API key → Restricted → check only Messaging > Messages > messages (Read/List/Create)
#   Twilio shows the Secret only once at creation — copy it immediately.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY_SECRET=your_api_key_secret_here
TWILIO_PHONE_NUMBER=+16175550000

# ── Email (Zoho Mail primary, AWS SES fallback) ─────────────────────────────
# Zoho: console.zoho.com → API Console. See src/lib/zohoMail.ts for setup.
ZOHO_CLIENT_ID=your_zoho_client_id
ZOHO_CLIENT_SECRET=your_zoho_client_secret
ZOHO_REFRESH_TOKEN=your_zoho_refresh_token
# AWS SES fallback — verified domain/address required in AWS SES console
AWS_SES_FROM=Edziban <orders@yourdomain.com>
AWS_ACCESS_KEY_ID=AKIAxxxxxxxxxxxxxxxx
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-2

# ── Make.com Webhooks ───────────────────────────────────────────────────────
# For each webhook: Make.com → Create Scenario → Add Webhooks module → Copy URL
# MAKE_WHATSAPP_WEBHOOK: Scenario that sends WhatsApp messages (via Twilio WhatsApp or Meta API)
MAKE_WHATSAPP_WEBHOOK=https://hook.us1.make.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAKE_ORDER_WEBHOOK: General Edziban automation scenario
MAKE_ORDER_WEBHOOK=https://hook.us1.make.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAKE_SUPPLIER_FOLLOWUP_WEBHOOK: Scenario with 2-hour delay that alerts admin if supplier hasn't replied
MAKE_SUPPLIER_FOLLOWUP_WEBHOOK=https://hook.us1.make.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# MAKE_REVIEW_DELAY_WEBHOOK: Scenario with 3-hour delay that sends review request after delivery
MAKE_REVIEW_DELAY_WEBHOOK=https://hook.us1.make.com/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── Manychat (Instagram DM Auto-Reply) ─────────────────────────────────────
# Get from: Manychat → Settings → API
MANYCHAT_API_KEY=your_manychat_api_key_here
MANYCHAT_PAGE_ID=your_facebook_page_id_here

# ── Supabase ────────────────────────────────────────────────────────────────
# Get from: app.supabase.com → Your Project → Settings → API
# IMPORTANT: Do NOT add NEXT_PUBLIC_ prefix — these keys are server-side only
SUPABASE_URL=https://xxxxxxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
